{
  "name": "@bks/schema-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Parses the pinned @neo4j/graphql SDL into a schema IR and materializes the progressive-disclosure agent workspace (index, domains, fragments, cards, search index, slices).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "bks-schema": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@bks/contracts": "workspace:*",
    "graphql": "^16.14.2",
    "openai": "7.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
