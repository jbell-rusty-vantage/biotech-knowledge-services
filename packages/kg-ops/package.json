{
  "name": "@bks/kg-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic knowledge-graph operations over Neo4j: bounded read intents, identity resolution, ingestion plan/apply/receipt, guarded ad hoc Cypher baseline tools, and the bks CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "bks": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@bks/contracts": "workspace:*",
    "@bks/schema-workspace": "workspace:*",
    "@neo4j-cypher/language-support": "2.0.0-next.37",
    "dotenv": "^16.4.5",
    "neo4j-driver": "^6.2.0",
    "pg": "8.16.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
