{
  "$id": "https://belllabs.dev/contracts/biotech-cypher-read-intent.v1.json",
  "title": "biotech-cypher-read-intent.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "biotech-cypher-read-intent.v1"
    },
    "intentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "pins": {
      "type": "object",
      "properties": {
        "schemaReleaseDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workspaceFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "queryCatalogDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schemaReleaseDigest"
      ],
      "additionalProperties": false
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "questionIds": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9.#-]{1,40}$"
      }
    },
    "contextArtifact": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "additionalProperties": false
    },
    "bindingRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "inputArtifacts": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "ref",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "default": {
        "rowCap": 100,
        "byteCap": 1048576,
        "timeoutMs": 10000,
        "maxDepth": 4,
        "listCap": 200,
        "nestingCap": 6
      },
      "type": "object",
      "properties": {
        "rowCap": {
          "default": 100,
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "byteCap": {
          "default": 1048576,
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304
        },
        "timeoutMs": {
          "default": 10000,
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "maxDepth": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "listCap": {
          "default": 200,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "nestingCap": {
          "default": 6,
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "additionalProperties": false
    },
    "consistency": {
      "default": {
        "mode": "observed",
        "bookmarks": [],
        "maxAttempts": 3
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "observed",
          "type": "string",
          "enum": [
            "observed",
            "stable_revision"
          ]
        },
        "bookmarks": {
          "default": [],
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "maxAttempts": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "persistSnapshot": {
      "default": false,
      "type": "boolean"
    },
    "language": {
      "default": "CYPHER_5",
      "type": "string",
      "const": "CYPHER_5"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "statementDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "template": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "statementDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "statementDigest"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "parameterSchema": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "resultSchema": {
      "type": "object",
      "properties": {
        "columns": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "type": {
                "type": "string",
                "maxLength": 80
              },
              "nullable": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "columns"
      ],
      "additionalProperties": false
    },
    "resultSchemaRef": {
      "type": "string",
      "maxLength": 200
    },
    "scope": {
      "default": {
        "labels": [],
        "relationshipTypes": [],
        "procedures": []
      },
      "type": "object",
      "properties": {
        "labels": {
          "default": [],
          "maxItems": 80,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          }
        },
        "relationshipTypes": {
          "default": [],
          "maxItems": 80,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "procedures": {
          "default": [],
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "additionalProperties": false
    },
    "ordering": {
      "default": "set",
      "type": "string",
      "enum": [
        "statement",
        "set"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "intentId",
    "pins",
    "purpose"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "items": {
          "$ref": "#/$defs/__schema1"
        },
        "pattern": {
          "type": "string",
          "maxLength": 400
        },
        "enum": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "neo4jType": {
          "type": "string",
          "enum": [
            "DateTime",
            "Date",
            "Duration",
            "LocalDateTime"
          ]
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {}
    }
  }
}
