    "kind": {
      "type": "string",
      "enum": [
        "node",
        "relationship",
        "edge-properties",
        "interface",
        "union",
        "enum",
        "vocabulary",
        "predicate",
        "assessment",
        "module",
        "domain",
        "task",
        "rule",
        "pattern",
        "question-set",
        "migration",
        "term",
        "question",
        "alias",
        "operational"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tokens": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bodyTokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "default": "",
      "type": "string"
    },
    "cardDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceRefs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executorOps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposalKinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pendingProposalKinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readOperations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identifierSchemes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uidToken": {
      "type": "string"
    },
    "archetype": {
      "type": "string"
    },
    "temporalScope": {
      "type": "string"
    },
    "relClass": {
      "type": "string"
    },
    "temporal": {
      "type": "string"
    },
    "exclusive": {
      "type": "boolean"
    },
    "from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edgePropertyType": {
      "type": "string"
    },
    "predicateKind": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "registrar": {
      "type": "string"
    },
    "subjectTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objectTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "typedEdge": {
      "type": "string"
    },
    "questionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "templateIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredIndexes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrationKind": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seeAlso": {
      "type": "array",
      "items": {
        "type": "string"
      }
