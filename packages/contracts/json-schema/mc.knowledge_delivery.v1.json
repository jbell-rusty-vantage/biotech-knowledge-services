{
  "$id": "https://belllabs.dev/contracts/mc.knowledge_delivery.v1.json",
  "title": "mc.knowledge_delivery.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "mc.knowledge_delivery.v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
    },
    "envelopeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payloadDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nativeDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectKey": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "delivery": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "rejected",
        "unresolved"
      ]
    },
    "verification": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "completed",
        "failed"
      ]
    },
    "nativeOutcome": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "nativeReceipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "receiptId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "lookup": {
              "type": "string",
              "maxLength": 400
            }
          },
          "required": [
            "receiptId",
            "digest",
            "lookup"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "heldItems": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "envelopeDigest",
    "payloadDigest",
    "nativeDigest",
    "effectKey",
    "delivery",
    "verification",
    "nativeOutcome",
    "nativeReceipt",
    "heldItems",
    "reason"
  ],
  "additionalProperties": false
}
