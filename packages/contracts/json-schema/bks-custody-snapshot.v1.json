{
  "$id": "https://belllabs.dev/contracts/bks-custody-snapshot.v1.json",
  "title": "bks-custody-snapshot.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "bks-custody-snapshot.v1"
    },
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "bytesDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope": {
      "type": "object",
      "properties": {
        "installationId": {
          "type": "string"
        },
        "applicationId": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        }
      },
      "required": [
        "installationId",
        "applicationId",
        "tenantId"
      ],
      "additionalProperties": false
    },
    "pins": {
      "type": "object",
      "properties": {
        "schemaReleaseDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schemaReleaseDigest"
      ],
      "additionalProperties": false
    },
    "consistency": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "observed",
            "stable_revision"
          ]
        },
        "graphRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "bookmarks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "graphRevision"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "nodes": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string",
                "pattern": "^hu:[a-z0-9-]+:[A-Za-z0-9][A-Za-z0-9._\\-/]*$"
              },
              "updatedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "uid",
              "updatedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "complete",
        "nodes"
      ],
      "additionalProperties": false
    },
    "digests": {
      "type": "object",
      "properties": {
        "queryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resultDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "receiptDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "queryDigest",
        "resultDigest",
        "receiptDigest"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "format",
    "ref",
    "bytesDigest",
    "issuer",
    "scope",
    "pins",
    "consistency",
    "dependencies",
    "createdAt"
  ],
  "additionalProperties": false
}
