          "additionalProperties": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "BKS_RELEASE_MISMATCH",
                "BKS_RELEASE_TAMPERED",
                "BKS_UNAUTHORIZED",
                "BKS_FORBIDDEN_SCOPE",
                "BKS_PLAN_NOT_FOUND",
                "BKS_PLAN_DIGEST_MISMATCH",
                "BKS_PLAN_FORGED",
                "BKS_WITNESS_INVALID",
                "BKS_WITNESS_EXPIRED",
                "BKS_WITNESS_REVOKED",
                "BKS_EFFECT_DUPLICATE",
                "BKS_EFFECT_CONFLICT",
                "BKS_EFFECT_PENDING",
                "BKS_EFFECT_UNRESOLVED",
                "BKS_STALE_REVISION",
                "BKS_STALE_PRECONDITION",
                "BKS_IDENTITY_CONFLICT",
                "BKS_SLOT_CONFLICT",
                "BKS_EVIDENCE_UNVERIFIED",
                "BKS_SNAPSHOT_UNVERIFIED",
                "BKS_UNSUPPORTED",
                "BKS_LIMIT_EXCEEDED",
                "BKS_TIMEOUT",
                "BKS_PARSE_REJECTED",
                "BKS_PROCEDURE_FORBIDDEN",
                "BKS_VISIBILITY_DENIED",
                "BKS_PARTIAL_REFUSED",
                "BKS_PARTIAL_NOT_CLOSED",
                "BKS_PLAN_REJECTED",
                "BKS_AUTHORITY_UNAVAILABLE"
