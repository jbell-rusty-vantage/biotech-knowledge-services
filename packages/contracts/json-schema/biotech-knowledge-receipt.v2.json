{
  "$id": "https://belllabs.dev/contracts/biotech-knowledge-receipt.v2.json",
  "title": "biotech-knowledge-receipt.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "biotech-knowledge-receipt.v2"
    },
    "receiptId": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "applied",
        "noop",
        "partial",
        "rejected",
        "failed",
        "duplicate",
        "unresolved"
      ]
    },
    "duplicateOf": {
      "type": [
        "string",
        "null"
      ]
    },
    "effect": {
      "type": "object",
      "properties": {
        "effectKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
        },
        "markerKey": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "properties": {
            "installationId": {
              "type": "string"
            },
            "applicationId": {
              "type": "string"
            },
            "tenantId": {
              "type": "string"
            }
          },
          "required": [
            "installationId",
            "applicationId",
            "tenantId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "effectKey",
        "markerKey",
        "scope"
      ],
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "properties": {
        "intentId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "intentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
