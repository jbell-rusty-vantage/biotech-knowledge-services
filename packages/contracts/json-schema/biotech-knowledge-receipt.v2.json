            },
            "kid": {
              "type": "string"
            },
            "iss": {
              "type": "string"
            },
            "iat": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "exp": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
