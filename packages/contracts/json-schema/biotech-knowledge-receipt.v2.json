            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "digest"
          ],
          "additionalProperties": false
        },
        "revocationEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
