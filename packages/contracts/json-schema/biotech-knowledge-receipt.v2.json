          "outcome": {
            "type": "string",
            "enum": [
              "applied",
              "failed",
              "unresolved"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "planDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
