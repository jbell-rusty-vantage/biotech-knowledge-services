      "type": "object",
      "properties": {
        "markerSchemaVersion": {
          "type": "string",
          "const": "bks-intent-marker.v2"
        },
        "dispatchId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
        },
        "markerDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
