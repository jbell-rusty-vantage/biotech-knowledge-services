  "required": [
    "schemaVersion",
    "receiptId",
    "outcome",
    "duplicateOf",
    "effect",
    "intent",
    "plan",
    "release",
    "attemptId",
    "priorGraphRevision",
    "nextGraphRevision",
    "witness",
    "activityUid",
    "proposals",
    "effects",
    "invariants",
    "counters",
    "failure",
    "recovery",
    "executedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
