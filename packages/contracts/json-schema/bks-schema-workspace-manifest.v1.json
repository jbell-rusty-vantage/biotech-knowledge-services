{
  "$id": "https://belllabs.dev/contracts/bks-schema-workspace-manifest.v1.json",
  "title": "bks-schema-workspace-manifest.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "bks-schema-workspace.v1"
    },
    "rendererVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "schema": {
      "type": "object",
      "properties": {
        "pinnedPath": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pinnedAt": {
          "type": "string"
        },
        "sourceRun": {
          "type": "string"
        },
        "catalogVersion": {
          "type": "string"
        }
      },
      "required": [
        "pinnedPath",
        "digest",
        "pinnedAt",
        "sourceRun",
        "catalogVersion"
      ],
      "additionalProperties": false
    },
    "sidecars": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "workspaceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "interfaces": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "relationshipFields": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "relationshipTypes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "relationshipTriples": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "edgePropertyTypes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "enums": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "unions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "domains": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "fragments": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "tasks": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "searchEntries": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nodes",
        "interfaces",
        "relationshipFields",
        "relationshipTypes",
        "relationshipTriples",
        "edgePropertyTypes",
        "enums",
        "unions",
        "domains",
        "fragments",
        "tasks",
        "searchEntries"
      ],
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "depth": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "required": [
          "depth",
          "name",
          "path",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fragments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nodeCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "slug",
          "title",
          "fragments",
          "nodeCount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "rendererVersion",
    "generatedAt",
    "schema",
    "sidecars",
    "workspaceFingerprint",
    "counts",
    "layers",
    "entryPoints",
    "domains"
  ],
  "additionalProperties": false
}
