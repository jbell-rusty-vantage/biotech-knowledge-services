{
  "$id": "https://belllabs.dev/contracts/biotech-cypher-read-explain.v1.json",
  "title": "biotech-cypher-read-explain.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "biotech-cypher-read-explain.v1"
    },
    "intentId": {
      "type": "string"
    },
    "accepted": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ROW_CAP",
              "BYTE_CAP",
              "LIST_CAP",
              "NESTING_CAP",
              "TIMEOUT",
              "CONCURRENCY_LIMIT",
              "PARSE_REJECTED",
              "CLAUSE_FORBIDDEN",
              "PROCEDURE_FORBIDDEN",
              "FUNCTION_FORBIDDEN",
              "LABEL_FORBIDDEN",
              "RELATIONSHIP_FORBIDDEN",
              "PROPERTY_FORBIDDEN",
              "FULL_ENTITY_RETURN",
              "UNBOUNDED_PATTERN",
              "VISIBILITY_UNPROVEN",
              "READ_AUTHORITY_UNAVAILABLE",
              "BINDING_FORBIDDEN",
              "RELEASE_MISMATCH",
              "CATALOG_MISMATCH",
              "TEMPLATE_NOT_FOUND",
              "TEMPLATE_UNSUPPORTED",
              "PARAMETER_INVALID",
              "RESULT_SCHEMA_MISMATCH",
              "STALE_REVISION",
              "TRANSIENT_RETRIES_EXHAUSTED",
              "DATABASE_ERROR",
              "DATABASE_FORBIDDEN",
              "ONTOLOGY_ARTIFACT_ABSENT",
              "VECTOR_SEARCH_DISABLED",
              "UNKNOWN_TYPE",
              "NOT_ADJUDICATED",
              "AMBIGUOUS"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          },
          "path": {
            "type": "string",
            "maxLength": 400
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "statementDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "planFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimatedRows": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "intentId",
    "accepted",
    "reasons",
    "statementDigest",
    "policy",
    "plan",
    "planFlags",
    "estimatedRows"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
