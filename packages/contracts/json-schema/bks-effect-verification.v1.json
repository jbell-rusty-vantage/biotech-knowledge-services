{
  "$id": "https://belllabs.dev/contracts/bks-effect-verification.v1.json",
  "title": "bks-effect-verification.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "bks-effect-verification.v1"
    },
    "effectKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
    },
    "receiptId": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "checked": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "failures": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "node",
              "relationship"
            ]
          },
          "key": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "ok"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "key",
          "ok",
          "checks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "effectKey",
    "receiptId",
    "total",
    "cursor",
    "nextCursor",
    "complete",
    "checked",
    "failures",
    "items"
  ],
  "additionalProperties": false
}
