{
  "$id": "https://belllabs.dev/contracts/bks-apply-witness-claims.v1.json",
  "title": "bks-apply-witness-claims.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aud": {
      "type": "string",
      "const": "bks-executor"
    },
    "jti": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope": {
      "type": "object",
      "properties": {
        "installationId": {
          "type": "string"
        },
        "applicationId": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        }
      },
      "required": [
        "installationId",
        "applicationId",
        "tenantId"
      ],
      "additionalProperties": false
    },
    "effectKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"
    },
    "intentDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schemaReleaseDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "partialPolicyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "decisionVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "iat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revocationGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "iss",
    "aud",
    "jti",
    "sub",
    "scope",
    "effectKey",
    "intentDigest",
    "planDigest",
    "schemaReleaseDigest",
    "evidenceDigest",
    "partialPolicyDigest",
    "policyVersion",
    "decisionVersion",
    "iat",
    "exp",
    "revocationGeneration"
  ],
  "additionalProperties": false
}
