  "scopes": {
    "read": [
      "schema.*",
      "read.typed",
      "read.templates",
      "read.cypher (only with a proven read-only principal)",
      "receipt.get",
      "verifyEffects",
      "serving.eligibility"
    ],
    "write": [
      "plan",
      "apply (witness required)"
    ],
    "privilegedGrants": [
      "adjudication.deliver",
      "projection.write",
      "report.publish",
      "assessment.accept"
    ],
    "admin": [
      "admission.revocation",
      "baseline.cypher (evaluation profile only)"
    ]
  },
  "limits": {
    "maxProposalsPerIntent": 500,
    "applyTransactionMs": 30000,
    "witnessLifetimeSeconds": 60,
    "verifyEffectsPageSizeMax": 500
  },
  "partialPolicy": {
    "modes": [
      "all",
      "include"
    ],
    "all": "refused when any proposal is held or rejected (BKS_PARTIAL_REFUSED)",
    "include": "closed under dependencies (BKS_PARTIAL_NOT_CLOSED otherwise)"
  },
  "receipts": {
    "contract": "biotech-knowledge-receipt.v2",
    "lookup": "GET /kg/receipt?effectKey= (scoped by installation/application/tenant)",
    "outcomes": [
      "applied",
      "noop",
      "partial",
      "rejected",
      "failed",
      "duplicate",
      "unresolved"
    ],
    "deliveryMapping": {
      "applied": "applied",
      "partial": "applied",
      "noop": "applied",
      "duplicate": "applied",
      "rejected": "rejected",
      "failed": "rejected | pending (BKS_WITNESS_EXPIRED, BKS_TIMEOUT, BKS_AUTHORITY_UNAVAILABLE, BKS_EFFECT_PENDING)",
      "unresolved": "unresolved"
    },
    "idempotency": "same effectKey + same intent and plan digests returns the recorded receipt (duplicate); a changed payload or plan is BKS_EFFECT_CONFLICT",
    "heldItems": "held proposals are recorded with their reason; verification completion with held graph admission is delivery pending, never a successful write"
  },
  "consistency": {
    "readModes": [
      "observed",
      "stable_revision"
    ],
    "writer": "database-scoped writer fence (KsWriteFence.graphRevision), one transaction per effect",
    "stale": "strict (BKS_STALE_REVISION; no implicit re-plan)",
    "graphRevisionIsNotAKnowledgeSequence": true
  },
  "recovery": {
    "receiptLookup": true,
    "atomicCrossStore": false,
    "lostResponse": "unresolved; reconcile by GET /kg/receipt with the original effectKey before any repeat",
    "cancellation": "client-side stop-new-work plus receipt reconciliation; the HTTP apply has no native cancellation; a committed effect stands and keeps its receipt",
    "revocation": "authorization at issuance plus bounded lease (<= 60 s); KsRevocationFence refuses older witnesses once delivered; serving recheck denies revoked effects while history is retained"
  },
  "custody": {
    "plans": "executor file custody (runs/release-v2/plans)",
    "knowledgeArtifacts": "adapter implemented (Supabase Storage, content-addressed, digest-checked); blocked: bucket knowledge-artifacts not present in the Biotech Supabase project"
  },
  "descriptorDigest": "sha256:dfe3e1b9c363a754b81949691a98295e3dcac06438bf237f6eace6e439de8228"
}
