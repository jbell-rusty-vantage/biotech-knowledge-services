  "policy": {
    "policyVersion": "bks-admission-policy/v1",
    "semantics": "authorization-at-issuance-plus-bounded-lease",
    "witness": {
      "format": "bks-apply-witness.v1",
      "alg": "Ed25519",
      "audience": "bks-executor",
      "maxLifetimeSeconds": 60
    },
    "requiredAuthorities": [
      "mission-control grant reference",
      "knowledge-services sealed verification custody (when the plan cites verifications)"
    ],
    "revocation": {
      "fence": "KsRevocationFence.generation",
      "delivery": "durable outbox, at least once",
      "servingRecheck": "GET /kg/eligibility"
    },
    "failClosed": "BKS_AUTHORITY_UNAVAILABLE",
    "policyDigest": "sha256:75ecdfd7ad987eca27f45a6cd1f0de1e258290d1920de6153c218772b1626a6e"
  },
  "interfaces": {
    "knowledge.describe": {
      "available": true,
      "native": "GET /describe",
      "role": "reader"
    },
    "knowledge.query": {
      "available": true,
      "native": "POST /kg/read",
      "role": "reader",
      "contract": "biotech-knowledge-read-intent.v2",
      "passthrough": "native read intent bytes; result status vocabulary biotech-knowledge-read-result.v2",
      "cypher": null
    },
    "knowledge.ingestion_plan": {
      "available": true,
      "native": "POST /kg/plan",
      "role": "writer",
      "contract": "biotech-knowledge-intent.v2",
      "output": "biotech-knowledge-plan.v2",
      "writes": false
    },
    "knowledge.ingestion_apply": {
      "available": true,
      "native": "POST /kg/apply",
      "role": "writer",
      "contract": "biotech-knowledge-apply.v2",
      "receipt": "biotech-knowledge-receipt.v2",
      "requiresWitness": true,
      "admission": "POST /kg/admission/witness"
    },
    "knowledge.receipt_get": {
      "available": true,
      "native": "GET /kg/receipt?effectKey=",
      "role": "reader",
      "notFound": 404
    },
    "knowledge.verify_result": {
      "available": true,
      "native": "POST /kg/verify-effects",
      "role": "reader",
      "contract": "bks-effect-verification.v1",
      "paginated": true
    },
    "knowledge.retrieve": {
      "available": false,
      "owner": "knowledge-services",
      "note": "no Biotech retrieval capability in this release (retrieve: available false)"
    },
    "knowledge.capture_prepare": {
      "available": false,
      "owner": "knowledge-services",
      "note": "capture/preparation is a Knowledge Services capability, not served by the Biotech executor"
    },
    "knowledge.verify": {
      "available": false,
      "owner": "knowledge-services",
      "note": "verification algorithms live in Knowledge Services; Biotech consumes sealed verification references"
    },
    "knowledge.classify_propose": {
      "available": false,
      "owner": "knowledge-services",
      "note": "no proved semantic classification endpoint"
    },
    "knowledge.classify_admit": {
      "available": false,
      "owner": "knowledge-services",
      "note": "no proved semantic classification endpoint"
    }
  },
