{
  "name": "@bks/product-bff",
  "version": "0.1.0",
  "private": true,
  "description": "Reference product BFF: verifies the application user session (Supabase JWKS), applies entitlements, keeps the GraphQL service credential server-side and forwards safelisted operations with a short-lived BFF-signed actor context.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@bks/graphql-client": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@bks/graphql-api": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
