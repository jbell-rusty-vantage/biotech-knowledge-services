          }
        },
        {
          "ref": "l-m-03",
          "selectorKind": "TEXT_QUOTE",
          "quote": "The dose for both placebo and metformin was 500 mg/day the first week and increased by 500 mg each week until reaching 2000 mg/day (1,000 mg twice daily) by week 4.",
          "quotePrefix": "placebo (lactose) or metformin. ",
          "quoteSuffix": " If participants weighed <75 kg,",
          "startOffset": 39215,
          "endOffset": 39379,
          "properties": {
            "offsetBasis": "jats-xml2txt/v1",
