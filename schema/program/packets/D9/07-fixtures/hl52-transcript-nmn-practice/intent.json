        {
          "ref": "l2",
          "selectorKind": "TEXT_QUOTE",
          "properties": {
            "speakerLabelInSource": "David Sinclair:"
          },
          "quote": "Now another important point, which is I'm not the same as everybody else. I have different microbiome, age, sex.",
