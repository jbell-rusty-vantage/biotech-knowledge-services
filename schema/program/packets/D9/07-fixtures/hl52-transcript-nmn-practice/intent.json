        {
          "ref": "l3",
          "selectorKind": "TEXT_QUOTE",
          "properties": {
            "speakerLabelInSource": "David Sinclair:"
          },
          "quote": "I was one of the first people in InsideTracker as a board member and I'm still their scientific lead guy.",
          "startOffset": 82514,
          "endOffset": 82619
        },
        {
          "ref": "l4",
          "selectorKind": "TEXT_QUOTE",
          "properties": {
            "speakerLabelInSource": "David Sinclair:"
          },
          "quote": "InsideTracker is one of them and you just do it a couple of times a year at a minimum.",
          "startOffset": 88338,
          "endOffset": 88424
        },
        {
          "ref": "l5",
          "selectorKind": "TEXT_QUOTE",
          "properties": {
            "speakerLabelInSource": "David Sinclair:"
          },
          "quote": "Go to doctorsinclair.com. You can get on that and you'll be one of the first people in the world to get this test and see what we're doing.",
          "startOffset": 137517,
          "endOffset": 137656
        },
        {
          "ref": "l6",
          "selectorKind": "TEXT_QUOTE",
          "properties": {},
          "quote": "ROKA, InsideTracker, Magic Spoon",
