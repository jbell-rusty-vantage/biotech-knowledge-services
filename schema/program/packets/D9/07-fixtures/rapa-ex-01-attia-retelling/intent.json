        },
        {
          "ref": "a7",
          "selectorKind": "TEXT_QUOTE",
          "properties": {},
          "quote": "Stanfield B, Leroux B, Kaeberlein M, Jones J, Lucas R. Exercise and weekly sirolimus (rapamycin) in older adults: RAPA-EX-01 randomised, double-blind, placebo-controlled trial.",
          "startOffset": 22986,
          "endOffset": 23162
