      "locators": [
        {
          "ref": "l10",
          "selectorKind": "TEXT_QUOTE",
          "section": "EX-99.1 dateline",
          "quote": "CONSHOHOCKEN, PA, March 14, 2024",
          "quotePrefix": " March 14, 2024, at 5:15 pm ET\n\n",
          "quoteSuffix": " – Madrigal Pharmaceuticals, Inc",
          "startOffset": 809,
          "endOffset": 841,
          "properties": {
            "selectorJson": "{\"basis\":\"h2t-v1 (_notes/tools/h2t_v1.py; UTF-8, LF)\",\"exact\":\"CONSHOHOCKEN, PA, March 14, 2024\",\"prefix\":\" March 14, 2024, at 5:15 pm ET\\n\\n\",\"refinedBy\":{\"end\":841,\"start\":809,\"type\":\"TextPositionSelector\"},\"suffix\":\" – Madrigal Pharmaceuticals, Inc\",\"type\":\"TextQuoteSelector\"}",
            "selectorDigest": "sha256:ef1d9b25bc2eec5c25687880c71c085b773e1f958ac97f872de5b9fefb668578"
          }
        },
        {
          "ref": "l11",
          "selectorKind": "TEXT_QUOTE",
          "section": "EX-99.1 body",
          "quote": "The accelerated approval of Rezdiffra was based on results from the Phase 3 MAESTRO-NASH trial",
          "quotePrefix": " key underlying causes of NASH. ",
          "quoteSuffix": ", which was recently published i",
          "startOffset": 3035,
          "endOffset": 3129,
          "properties": {
            "selectorJson": "{\"basis\":\"h2t-v1 (_notes/tools/h2t_v1.py; UTF-8, LF)\",\"exact\":\"The accelerated approval of Rezdiffra was based on results from the Phase 3 MAESTRO-NASH trial\",\"prefix\":\" key underlying causes of NASH. \",\"refinedBy\":{\"end\":3129,\"start\":3035,\"type\":\"TextPositionSelector\"},\"suffix\":\", which was recently published i\",\"type\":\"TextQuoteSelector\"}",
            "selectorDigest": "sha256:2f1a45a8d1048dc3d8624f2f015793a252bed1f83669b0ef624831abfa80f00b"
          }
        },
        {
          "ref": "l12",
          "selectorKind": "TEXT_QUOTE",
          "section": "EX-99.1 body",
          "quote": "MAESTRO-NASH remains ongoing as an outcomes study designed to generate confirmatory data that, if positive, will help verify clinical benefit and may support\nfull approval.",
          "quotePrefix": "ant and premature mortality.” \n\n",
          "quoteSuffix": " A second ongoing outcomes trial",
          "startOffset": 5170,
          "endOffset": 5342,
          "properties": {
            "selectorJson": "{\"basis\":\"h2t-v1 (_notes/tools/h2t_v1.py; UTF-8, LF)\",\"exact\":\"MAESTRO-NASH remains ongoing as an outcomes study designed to generate confirmatory data that, if positive, will help verify clinical benefit and may support\\nfull approval.\",\"prefix\":\"ant and premature mortality.” \\n\\n\",\"refinedBy\":{\"end\":5342,\"start\":5170,\"type\":\"TextPositionSelector\"},\"suffix\":\" A second ongoing outcomes trial\",\"type\":\"TextQuoteSelector\"}",
            "selectorDigest": "sha256:cd5eb05ed3d7b1ccfba694e3b7ef312141858938ac2d2c6295311c1a61013e5d"
          }
        },
        {
          "ref": "l13",
          "selectorKind": "TEXT_QUOTE",
          "section": "EX-99.1 body",
          "quote": "Rezdiffra is expected to be available to patients in the U.S. in April and will be distributed through a",
          "quotePrefix": "tory benefit-risk assessment. \n\n",
          "quoteSuffix": "\nlimited specialty pharmacy netw",
          "startOffset": 6063,
          "endOffset": 6167,
          "properties": {
            "selectorJson": "{\"basis\":\"h2t-v1 (_notes/tools/h2t_v1.py; UTF-8, LF)\",\"exact\":\"Rezdiffra is expected to be available to patients in the U.S. in April and will be distributed through a\",\"prefix\":\"tory benefit-risk assessment. \\n\\n\",\"refinedBy\":{\"end\":6167,\"start\":6063,\"type\":\"TextPositionSelector\"},\"suffix\":\"\\nlimited specialty pharmacy netw\",\"type\":\"TextQuoteSelector\"}",
            "selectorDigest": "sha256:66f7313ea682719e2dd348365c024e93eb697d48503ae58dcc006081d4d6cec3"
          }
        },
        {
          "ref": "l14",
          "selectorKind": "TEXT_QUOTE",
          "section": "EX-99.1 headline bullets",
          "quote": "Rezdiffra becomes the first and only medication approved by the FDA for the treatment of NASH",
          "quotePrefix": "ver Fibrosis \n\n | \n | •\n | \n | \n",
          "quoteSuffix": " (also known as\n“MASH”) \n\n | \n |",
          "startOffset": 280,
