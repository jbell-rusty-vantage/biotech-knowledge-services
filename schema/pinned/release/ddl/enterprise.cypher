CREATE CONSTRAINT ks_revocation_fence_generation_exists IF NOT EXISTS FOR (n:KsRevocationFence) REQUIRE n.generation IS NOT NULL;
CREATE CONSTRAINT ks_write_fence_lock_seq_exists IF NOT EXISTS FOR (n:KsWriteFence) REQUIRE n.lockSeq IS NOT NULL;
CREATE CONSTRAINT ks_release_marker_release_id_exists IF NOT EXISTS FOR (n:KsReleaseMarker) REQUIRE n.releaseId IS NOT NULL;
CREATE CONSTRAINT ks_release_marker_ddl_digest_exists IF NOT EXISTS FOR (n:KsReleaseMarker) REQUIRE n.ddlDigest IS NOT NULL;
CREATE CONSTRAINT ks_release_marker_installed_at_exists IF NOT EXISTS FOR (n:KsReleaseMarker) REQUIRE n.installedAt IS NOT NULL;
