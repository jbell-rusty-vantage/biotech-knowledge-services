# --- Biotech database and graph credentials (plane BIOTECH; names only, never commit values) -----------------------
# Registry: config/env.registry.yaml. Guide: docs/ENVIRONMENT.md. No older names (NEO4J_*, NEO4J_AURA_*, SUPABASE_*,
# BKS_VERIFICATION_*DSN) are read. Values: BellLabs/.secrets/biotech-db.env and biotech-graph.env with BKS_ prepended.

# Supabase / PostgreSQL (biotech-db).
BKS_BIOTECH_DB_PROJECT_REF=                # Supabase project ref; when set, URL/DSN values below must name it (executor refuses otherwise)
BKS_BIOTECH_DB_URL=                        # https://<ref>.supabase.co: knowledge-artifacts Storage custody; product BFF session issuer fallback
BKS_BIOTECH_DB_PUBLISHABLE_KEY=            # declared; nothing in this repository reads it
BKS_BIOTECH_DB_SECRET_KEY=                 # server-side Storage key for knowledge-artifacts custody (library SupabaseStorageObjectStore.fromEnv; no process wires it yet)
BKS_BIOTECH_DB_JWKS_URL=                   # product BFF: application session JWKS (https://<ref>.supabase.co/auth/v1/.well-known/jwks.json)
BKS_BIOTECH_DB_ADMIN_DSN=                  # schema-owner DSN for installers; passed by NAME (--pg-admin-dsn-env, target.toml database_url_env)
BKS_BIOTECH_DB_VERIFICATION_DSN=           # login holding knowledge_verification_outbox_worker (dispatch consumer, /kg/admission/dispatch/consume)
BKS_BIOTECH_DB_VERIFICATION_READ_DSN=      # optional reader for official-use reads (read-intent.v3); defaults to BKS_BIOTECH_DB_VERIFICATION_DSN

# Neo4j Aura (biotech-graph). Local development: a disposable container (scripts/neo4j-test.sh), e.g. neo4j://localhost:7687.
BKS_BIOTECH_GRAPH_INSTANCE_ID=             # Aura instance id; declared, not read
BKS_BIOTECH_GRAPH_URI=neo4j://localhost:7687
BKS_BIOTECH_GRAPH_USERNAME=neo4j           # executor/CLI writer login; GraphQL API fallback login
BKS_BIOTECH_GRAPH_PASSWORD=change-me
BKS_BIOTECH_GRAPH_DATABASE=neo4j           # non-secret database name (required explicitly by the GraphQL API in production)
BKS_BIOTECH_GRAPH_READER_USERNAME=         # optional GraphQL API read-only login (bks_reader_public_svc); falls back to the primary login with a warning
BKS_BIOTECH_GRAPH_READER_PASSWORD=

# GraphQL API (apps/graphql-api, apps/graphql-api/src/config.ts). Production refuses the four "true"/"skip" switches
# below; environment limits may only tighten the release policy (defaults in parentheses are the policy ceilings).
PORT=4010
GRAPHQL_PROFILE=product           # product (persisted operations only) | engineering (needs GRAPHQL_ENGINEERING_KEY)
GRAPHQL_ENGINEERING_KEY=          # >= 32 characters; only with GRAPHQL_PROFILE=engineering
GRAPHQL_API_KEY=                  # service credential held by the product BFF (x-api-key); >= 32 characters in production
GRAPHQL_ACTOR_PUBLIC_KEY=         # BFF actor-context Ed25519 public key (SPKI PEM or JWKS); required by the product profile
GRAPHQL_ACTOR_ISSUER=             # default bks-product-bff
GRAPHQL_ACTOR_AUDIENCE=           # default bks-graphql-api
GRAPHQL_ALLOW_MUTATIONS=false     # true is refused in production: the consumer executable has no Mutation root
GRAPHQL_ENABLE_VECTOR=false       # true is refused in production: product vector search is unsupported in this release
GRAPHQL_ENSURE_OPERATIONS=false   # true is refused in production: DDL belongs to the migration job
GRAPHQL_READINESS_RELEASE_CHECK=  # enforce (default) | skip (non-production only)
GRAPHQL_READINESS_CACHE_MS=       # /readyz result cache (default 5000)
GRAPHQL_WARMUP=                   # false skips the plan warm-up before /readyz (default true)
GRAPHQL_MAX_DEPTH=                # field nesting
GRAPHQL_MAX_COST=                 # estimated node rows per operation
GRAPHQL_MAX_OFFSET=               # offsets and cursors
GRAPHQL_MAX_TOKENS=               # parser token ceiling per request document
GRAPHQL_TX_TIMEOUT_MS=            # Neo4j transaction timeout per query; must stay below GRAPHQL_DEADLINE_MS
GRAPHQL_DEADLINE_MS=              # end-to-end request deadline
GRAPHQL_BODY_LIMIT_BYTES=         # request body limit
GRAPHQL_MAX_RESPONSE_BYTES=       # response size limit
NEO4J_MAX_POOL_SIZE=              # driver tuning for the GraphQL API (not credentials): pool (default 20)
NEO4J_ACQUISITION_TIMEOUT_MS=     # connection acquisition (default 2000)
NEO4J_CONNECTION_TIMEOUT_MS=      # connect (default 3000)
NEO4J_MAX_RETRY_TIME_MS=          # transaction retry (default 1000)
WEB_ORIGIN=                       # CORS allow-list, comma separated
BKS_DEBUG_ERRORS=                 # 1 = log GraphQL error messages to stderr (local debugging)
BKS_SCHEMA_RELEASE_DIR=           # non-production override of schema/pinned (also honored by the schema workspace); refused in production
BKS_CONSUMER_CANDIDATE_SDL=       # non-production candidate SDL for the consumer API; refused in production
# Local docker compose only (apps/graphql-api/docker-compose.yml): password of the disposable local Neo4j container.
BKS_LOCAL_GRAPH_PASSWORD=

# Reference product BFF (apps/product-bff/src/config.ts). Also reads BKS_BIOTECH_DB_JWKS_URL and BKS_BIOTECH_DB_URL above.
BFF_SESSION_ISSUER=               # default <BKS_BIOTECH_DB_URL>/auth/v1
BFF_SESSION_AUDIENCE=             # default authenticated
BFF_SESSION_ALGORITHMS=           # default ES256,RS256,EdDSA
BFF_REQUIRED_ROLE=                # default authenticated; empty string = no role requirement
BFF_ENTITLEMENTS_CLAIM=           # app_metadata claim name (default bks_entitlements)
BFF_REQUIRED_ENTITLEMENT=
BFF_INTERNAL_ENTITLEMENT=         # default biotech:internal
BFF_ACTOR_PRIVATE_KEY=            # Ed25519 PKCS8 PEM signing the actor context; its public key is GRAPHQL_ACTOR_PUBLIC_KEY
BFF_ACTOR_KEY_ID=
BFF_ACTOR_ISSUER=                 # must equal GRAPHQL_ACTOR_ISSUER
BFF_ACTOR_AUDIENCE=               # must equal GRAPHQL_ACTOR_AUDIENCE
BFF_ACTOR_TTL_SECONDS=            # 5..120 (default 60)
BFF_APP_ID=                       # default bks-reference-bff
BFF_UPSTREAM_DEADLINE_MS=         # <= 8000
GRAPHQL_URL=                      # consumer API URL (https, or a private .internal address in production)
# The BFF sends GRAPHQL_API_KEY (same value as the GraphQL API's) upstream.

# Executor (apps/executor): HTTP + MCP surface over schema workspace and kg-ops
EXECUTOR_PORT=4020
EXECUTOR_API_KEY=
BKS_WORKSPACE_DIR=./workspace
BKS_RUNS_DIR=./runs                # CLI convenience outputs only (bks kg ... auto --out files); NOT custody (see BKS_RELEASE_RUNS_DIR)

# Ingestion actor identity written into Activity / Agent nodes
BKS_AGENT_UID=hu:agent:bks-executor

# Cypher baseline guard caps
BKS_CYPHER_MAX_DELETED_NODES=5
BKS_CYPHER_MAX_DELETED_RELATIONSHIPS=25
BKS_CYPHER_ROW_CAP=200
BKS_CYPHER_TIMEOUT_MS=30000

# Semantic / hybrid schema search (packages/schema-workspace/src/semantic). Off by default; lexical search needs nothing.
BKS_SEMANTIC_ENABLED=              # true = enable semantic / hybrid search (default false)
OPENAI_API_KEY=                    # server-side embedding key; only read when semantic search runs (never by the GraphQL API)
BKS_SEMANTIC_CUSTODY_DIR=          # generation custody directory (default runs/release-v2/custody/semantic)
BKS_SEMANTIC_GENERATION=           # generation id to bind (default: the current.json pointer)
BKS_SEMANTIC_DEADLINE_MS=          # hosted search deadline (default 5000)
BKS_SEMANTIC_MAX_REQUESTS=         # per-process hosted request ceiling (default 600)
BKS_SEMANTIC_MAX_SPEND_USD=        # optional spend ceiling, enforced with BKS_SEMANTIC_COST_PER_SEARCH_USD
BKS_SEMANTIC_COST_PER_SEARCH_USD=

# Operator tooling, not read by the services: Fly.io token for scripts/fly.sh (FLY_API_TOKEN or FLY_TOKEN; never printed),
# and research CLIs/MCP servers of the schema program agent team (tvly, firecrawl, exa; MCP servers in .mcp.json).
FLY_API_TOKEN=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
EDGAR_IDENTITY=                    # "Name email" required by SEC EDGAR (edgartools MCP)

# Native executor v2 (S3: apps/executor + packages/kg-ops writer). Names and meaning only; never commit values.
BKS_LOCAL_DEV=                     # 1 = local development: unauthenticated requests get the local-dev principal, dev witness authority, release-marker bypass. Never in production.
BKS_LOCAL_DEV_ROLE=                # local-dev principal role (reader|writer|admin; default writer)
BKS_LOCAL_DEV_GRANTS=              # comma-separated grants of the local-dev principal (e.g. report.publish,projection.write)
BKS_EXECUTOR_TOKENS=               # JSON array of {tokenSha256 (preferred) or token, role reader|writer|admin, principalId, installationId, applicationId, tenantId, grants}; required unless BKS_LOCAL_DEV=1
BKS_MCP_TOKEN=                     # the configured token the MCP (stdio) process acts as
BKS_ENABLE_BASELINE_TOOLS=         # 1 = evaluation profile only: exposes cypher_run / `cypher write` (canonical writes always go through plan/apply)
BKS_WRITE_RELEASE_SOURCE=          # pinned (default: schema/pinned via loadRelease()) | candidate (frozen schema/program/final candidate; comparison only)
BKS_CANDIDATE_RELEASE_DIR=         # override directory of the candidate release (only with BKS_WRITE_RELEASE_SOURCE=candidate)
BKS_WITNESS_ISSUER=                # admission witness issuer name (default bks-admission-dev)
BKS_WITNESS_SIGNING_KEY=           # development admission authority signing key, kid:<base64 PKCS8 DER Ed25519>; production witnesses come from the admission service
BKS_WITNESS_ISSUER_KEYS=           # pinned witness issuer public keys, kid:<base64 SPKI DER>[,kid:...]
BKS_VERIFIER_ISSUER_KEYS=          # pinned sealed-verification (verifier) public keys, kid:<base64 SPKI DER>[,...]
BKS_SNAPSHOT_ISSUERS=              # trusted snapshot custody issuers (default bks-read-service,bks-executor)
BKS_RELEASE_RUNS_DIR=              # custody root for plans, receipts, snapshots, verifications and the admission ledger (default ./runs/release-v2; production: a persistent volume, e.g. /data/runs)
BKS_CLI_PRINCIPAL=                 # `bks kg` CLI principal as JSON {principalId, installationId, applicationId, tenantId, grants}
BKS_DISABLE_READ_V1=               # 1 = drop the v1 read module from the executor
BKS_EXECUTOR_URL=                  # Python client: executor base URL (default http://127.0.0.1:4020)
BKS_EXECUTOR_API_KEY=              # Python client: bearer token sent to the executor
BKS_JSON_SCHEMA_DIR=               # Python client: packages/contracts/json-schema location override
# Tests only: BKS_INTEGRATION=1 with NEO4J_TEST_URI / NEO4J_EE_TEST_URI / NEO4J_TEST_PASSWORD (disposable local containers,
# scripts/neo4j-test.sh, BKS_NEO4J_EDITION=community|enterprise); BKS_UPDATE_GOLDEN=1 / BKS_UPDATE_ROUND=1 regenerate vectors.
# Domain admission (S7: apps/executor/src/modules/admission.ts, packages/kg-ops/src/admission). Names only.
BKS_ADMISSION_ENABLED=             # 1 = serve the admission / revocation surface (needs BKS_WITNESS_SIGNING_KEY and a grant source)
BKS_ADMISSION_GRANT_SOURCE=        # file:<path> or http(s) URL of the Mission Control grant authority
BKS_ADMISSION_GRANT_TOKEN=         # bearer token for an http(s) grant source
BKS_ADMISSION_LEDGER=              # durable admission ledger path (default <custody root>/admission/ledger.json)
BKS_ADMISSION_LEDGER_CREATE=       # 1 = create the ledger if absent (first install only; otherwise a missing or unreadable ledger fails closed)
BKS_ADMISSION_EVIDENCE=            # custody | none: sealed verification authority (default custody)
BKS_ADMISSION_VERIFICATION_STATE=  # optional file:<path> or http(s) URL of the Knowledge Services verification state
BKS_ADMISSION_VERIFICATION_TOKEN=  # bearer token for an http(s) verification state source
# Consumer side of this executor (set in Knowledge Services' biotech-graph binding / the Mission Control runtime
# environment, listed here for reference only): KS_BIOTECH_EXECUTOR_URL, KS_BIOTECH_EXECUTOR_TOKEN,
# KS_BIOTECH_EXECUTOR_READ_TOKEN, KS_BIOTECH_EXECUTOR_TIMEOUT_MS.
# Native reads (S4: apps/executor/src/modules/read.ts, packages/kg-ops/src/read). Names only.
BKS_READ_BINDINGS=                 # JSON [{ref, scope public|internal, uriEnv, userEnv, passwordEnv, database, readAuthority, visibility}]; names env vars, never values
BKS_READ_AUTHORITY=                # session-routing (default) | database-role (read-only database principal; enables ad hoc Cypher after a refused-write proof)
BKS_READ_VISIBILITY=               # application (default) | database-rbac (public visibility enforced by bks_reader_public)
BKS_READ_MAX_CONCURRENT=           # concurrent reads per process (default 8)
BKS_READ_MAX_CONCURRENT_PER_PRINCIPAL=  # concurrent reads per principal (default 4)
BKS_READ_V1_RETIRED=               # 1 = POST /kg/read refuses biotech-knowledge-read-intent.v1 bodies (BKS_UNSUPPORTED)
# Production guard and env loading (S3).
BKS_TARGET=                        # production = allow connections to *.databases.neo4j.io (Aura); unset everywhere else (executor and CLI refuse Aura hosts)
BKS_ENV_FILE=                      # explicit env file to load (default ./.env); the loaded path is printed to stderr, never its contents
BKS_NO_ENV_FILE=                   # 1 = load no env file (containers: configuration comes from the platform secrets)
BKS_NEO4J_ACQUISITION_TIMEOUT_MS=  # driver connection-acquisition timeout (default 10000)
BKS_NEO4J_CONNECT_TIMEOUT_MS=      # driver connect timeout (default 5000)

# --- Sprint V SV-11: Knowledge Services dispatch admission (common component knowledge_verification in the Biotech
# application PostgreSQL). Names only here; never commit values.
# Login role: BKS_BIOTECH_DB_VERIFICATION_DSN (database block at the top of this file).
# Comma-separated knowledge_verification tenant uuids this executor consumes for (enables POST /kg/admission/dispatch/consume).
BKS_VERIFICATION_TENANTS=
# Per-call PostgreSQL timeout in ms (default 5000).
BKS_VERIFICATION_TIMEOUT_MS=
# Planner grants of the dispatch principal (default report.publish,assessment.accept,adjudication.deliver) and claim size.
BKS_ADMISSION_CONSUMER_GRANTS=
BKS_ADMISSION_CONSUMER_LIMIT=
