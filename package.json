{
  "name": "biotech-knowledge-services",
  "version": "0.1.0",
  "private": true,
  "description": "BellLabs Biotech Knowledge Services: schema workspace, deterministic knowledge-graph read/ingest executor, GraphQL API deployment, agent skills.",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --noEmit false --emitDeclarationOnly false --dry",
    "clean": "node -e \"for (const d of ['packages/contracts','packages/schema-workspace','packages/kg-ops','apps/graphql-api','apps/executor']) require('node:fs').rmSync(d+'/dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:integration": "cross-env BKS_INTEGRATION=1 vitest run --project kg-ops",
    "test:installer": "node --test scripts/install-target.test.mjs",
    "workspace:build": "node packages/schema-workspace/dist/cli.js build",
    "workspace:verify": "node packages/schema-workspace/dist/cli.js verify",
    "schema:map": "node packages/schema-workspace/dist/cli.js map --out schema/program/schema-map.md",
    "schema:pin": "node scripts/release/pin.mjs",
    "schema:release:promote": "node scripts/release/promote.mjs",
    "schema:release:generate": "node scripts/release/generate.mjs",
    "schema:release:check": "node scripts/release/promote.mjs --check && node scripts/release/generate.mjs --check",
    "schema:release:verify": "node scripts/release/verify.mjs",
    "schema:release:explain": "node scripts/release/explain-catalog.mjs",
    "schema:release:ddl": "node scripts/release/apply-ddl.mjs",
    "schema:release:parity": "node scripts/release/yaml-parity.mjs",
    "contracts:json-schema": "pnpm --filter @bks/contracts exec tsx src/export-json-schema.ts",
    "bks": "pnpm --filter @bks/kg-ops exec bks",
    "neo4j:test:up": "bash scripts/neo4j-test.sh up",
    "neo4j:test:down": "bash scripts/neo4j-test.sh down",
    "executor:dev": "pnpm --filter @bks/executor dev",
    "executor:mcp": "node apps/executor/dist/mcp.js",
    "api:dev": "pnpm --filter @bks/graphql-api dev",
    "api:generate": "pnpm --filter @bks/graphql-api generate",
    "api:print-schema": "pnpm --filter @bks/graphql-api print-schema",
    "api:registry": "pnpm --filter @bks/graphql-api registry",
    "api:projection:cuts": "pnpm --filter @bks/graphql-api projection:cuts",
    "api:check": "pnpm --filter @bks/graphql-api check",
    "api:bench:seed": "pnpm --filter @bks/graphql-api exec tsx bench/seed.ts",
    "api:bench:plans": "pnpm --filter @bks/graphql-api exec tsx bench/plans.ts",
    "api:bench:load": "pnpm --filter @bks/graphql-api exec tsx bench/load.ts",
    "api:bench:build": "pnpm --filter @bks/graphql-api exec tsx bench/build.ts",
    "bff:dev": "pnpm --filter @bks/product-bff dev",
    "client:codegen": "pnpm --filter @bks/graphql-client codegen",
    "client:pack-check": "node packages/graphql-client/scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
