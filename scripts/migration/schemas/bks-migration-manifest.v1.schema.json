{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://belllabs.local/schemas/bks-migration-manifest.v1.schema.json",
  "title": "bks-migration-manifest.v1",
  "description": "Deterministic plan for migrating a verified graph export into a Biotech schema release. Produced by packages/kg-ops/src/migration/plan-migration.mjs without writing; executed batch by batch under the canonical writer fence. Time-valued fields are filled by the apply clock, never by the plan.",
  "type": "object",
  "required": ["format", "migrationRunId", "plannerVersion", "map", "source", "target", "uidMap", "transformations", "temporal", "provenance", "batches", "checkpoint", "expected", "invariants", "quarantine", "releaseMarker", "rollback", "accountingSummary", "files", "manifestDigest"],
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "categoryTotals": {
      "type": "object",
      "required": ["migrated", "unchanged-retained", "held", "excluded"],
      "additionalProperties": false,
      "properties": {
        "migrated": { "type": "integer", "minimum": 0 },
        "unchanged-retained": { "type": "integer", "minimum": 0 },
        "held": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "format": { "const": "bks-migration-manifest.v1" },
    "migrationRunId": { "type": "string", "pattern": "^mig-[0-9a-f]{12}$", "description": "mig-<shortHash(exportDigest|mapDigest|plannerVersion)>; the same inputs always yield the same run id" },
    "plannerVersion": { "type": "string" },
    "manifestDigest": { "$ref": "#/$defs/digest", "description": "sha256 of the canonical manifest without this field" },
    "map": {
      "type": "object",
      "required": ["path", "digest", "mapVersion"],
      "properties": { "path": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" }, "mapVersion": { "type": "string" } }
    },
    "source": {
      "type": "object",
      "required": ["kind", "exportId", "exportDigest", "exportFormat", "counts", "files"],
      "properties": {
        "kind": { "enum": ["live-legacy-graph", "v1-shaped-import"] },
        "exportId": { "type": "string" },
        "exportDigest": { "$ref": "#/$defs/digest" },
        "exportFormat": { "const": "bks-graph-export.v1" },
        "server": { "type": ["string", "null"] },
        "counts": {
          "type": "object",
          "required": ["nodes", "relationships", "labels", "relationshipTypes"],
          "properties": { "nodes": { "type": "integer" }, "relationships": { "type": "integer" }, "labels": { "$ref": "#/$defs/counts" }, "relationshipTypes": { "$ref": "#/$defs/counts" } }
        },
        "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hex" } }
      }
    },
    "target": {
      "type": "object",
      "required": ["releaseId", "parentBaseline", "schemaReleaseDigest", "schemaReleaseDigestBound", "ddlDigest"],
      "properties": {
        "releaseId": { "type": "string" },
        "parentBaseline": { "$ref": "#/$defs/digest" },
        "schemaReleaseDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "schemaReleaseDigestBound": { "type": "boolean", "description": "apply refuses while false" },
        "ddlDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "note": { "type": "string" }
      }
    },
    "uidMap": {
      "type": "object",
      "required": ["file", "entries"],
      "description": "uid-map.jsonl: legacy elementId/label/key -> v2 uid, v2 type and identity tuple (keys, tuple, tier exact|provisional|unresolved); plus identifier, assertion and locator uids",
      "properties": { "file": { "const": "uid-map.jsonl" }, "entries": { "type": "integer", "minimum": 0 } }
    },
    "transformations": {
      "type": "object",
      "required": ["enumMaps", "propertyMapRef", "transforms"],
      "properties": {
        "enumMaps": { "type": "object", "additionalProperties": { "type": "object" } },
        "propertyMapRef": { "type": "string" },
        "transforms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "temporal": { "type": "object", "description": "copied from the map policy: source semantics kept, no invented dates" },
    "provenance": {
      "type": "object",
      "required": ["agentUid", "activityUid", "researchActivityUids", "sourceUid", "snapshotUid", "locators", "assertionStatus", "evidenceEdge"],
      "properties": {
        "agentUid": { "type": "string", "pattern": "^hu:agent:" },
        "activityUid": { "type": "string", "pattern": "^hu:activity:" },
        "researchActivityUids": { "type": "array", "items": { "type": "string", "pattern": "^hu:activity:" } },
        "sourceUid": { "type": "string", "pattern": "^hu:source:" },
        "snapshotUid": { "type": "string", "pattern": "^hu:snapshot:" },
        "locators": { "type": "integer", "minimum": 0 },
        "assertionStatus": { "const": "EXTRACTED" },
        "evidenceEdge": { "type": "object", "required": ["role", "origin"], "properties": { "role": { "const": "CONTEXT" }, "origin": { "const": "DECLARED" } } }
      }
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["batchId", "kind", "count", "batchDigest", "effectKey", "uidCount"],
        "properties": {
          "batchId": { "type": "string", "pattern": "^b[0-9]{3}-" },
          "kind": { "enum": ["spine", "nodes", "identifiers", "locators", "assertions", "relationships", "migratedFrom", "relabel"] },
          "count": { "type": "integer", "minimum": 0 },
          "batchDigest": { "$ref": "#/$defs/digest" },
          "effectKey": { "type": "string", "pattern": "^migration:mig-[0-9a-f]{12}:b[0-9]{3}-" },
          "uidCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["identity", "marker", "transaction", "restart"],
      "properties": { "identity": { "type": "string" }, "marker": { "type": "string" }, "transaction": { "type": "string" }, "restart": { "type": "string" } }
    },
    "expected": {
      "type": "object",
      "required": ["v2NodesByLabel", "provenanceNodes", "relationshipsByType", "assertionsByPredicate", "legacyNodes", "legacyRelationships", "relabeled", "tagged"],
      "properties": {
        "v2NodesByLabel": { "$ref": "#/$defs/counts" },
        "provenanceNodes": { "$ref": "#/$defs/counts" },
        "relationshipsByType": { "$ref": "#/$defs/counts" },
        "assertionsByPredicate": { "$ref": "#/$defs/counts" },
        "legacyNodes": { "type": "integer" },
        "legacyRelationships": { "type": "integer" },
        "relabeled": { "type": "integer" },
        "tagged": { "type": "integer" }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "expect"],
        "properties": { "id": { "type": "string" }, "statement": { "type": "string" }, "expect": { "type": "integer" }, "params": { "type": "object" }, "phase": { "enum": ["after-marker"] } }
      }
    },
    "quarantine": {
      "type": "object",
      "required": ["nodes", "relationships", "reasons", "identityCandidates"],
      "properties": { "nodes": { "type": "integer" }, "relationships": { "type": "integer" }, "reasons": { "$ref": "#/$defs/counts" }, "identityCandidates": { "type": "integer" } }
    },
    "releaseMarker": {
      "type": "object",
      "required": ["label", "writtenLast", "fields"],
      "properties": { "label": { "const": "KsReleaseMarker" }, "writtenLast": { "const": true }, "fields": { "type": "array", "items": { "type": "string" }, "contains": { "const": "schemaReleaseDigest" } } }
    },
    "rollback": {
      "type": "object",
      "required": ["material", "beforeV2Writes", "afterV2Writes"],
      "properties": {
        "material": { "type": "object", "required": ["exportId", "exportDigest", "custodyPath"], "properties": { "exportId": { "type": "string" }, "exportDigest": { "$ref": "#/$defs/digest" }, "custodyPath": { "type": "string" } } },
        "beforeV2Writes": { "type": "array", "items": { "type": "string" } },
        "afterV2Writes": { "type": "string" }
      }
    },
    "accountingSummary": {
      "type": "object",
      "required": ["totals", "reconcile"],
      "properties": {
        "totals": { "type": "object", "required": ["nodes", "relationships"], "properties": { "nodes": { "$ref": "#/$defs/categoryTotals" }, "relationships": { "$ref": "#/$defs/categoryTotals" } } },
        "reconcile": {
          "type": "object",
          "required": ["nodes", "relationships"],
          "properties": {
            "nodes": { "type": "object", "required": ["input", "accounted", "ok"], "properties": { "ok": { "const": true } } },
            "relationships": { "type": "object", "required": ["input", "accounted", "ok"], "properties": { "ok": { "const": true } } }
          }
        }
      }
    },
    "files": { "type": "object", "required": ["uid-map.jsonl", "accounting-records.jsonl", "batches.jsonl", "accounting.json"], "additionalProperties": { "$ref": "#/$defs/hex" } }
  }
}
