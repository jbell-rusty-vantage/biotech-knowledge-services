      "vendorSays": "provision instances, create users/roles, run neo4j-admin, bulk import",
      "releaseRule": "operator capability with separate credentials (bks_migrator / admin); never loaded into research or ingestion agents; no Aura API client credentials exist in this environment, so console snapshots and provisioning are operator actions",
      "authority": "AGENT-SKILLS section 2; S0 section 3"
    }
