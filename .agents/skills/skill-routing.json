    },
    {
      "id": "OV-SCHEMA-SOURCE",
      "appliesTo": [
        "neo4j-cypher-skill",
        "neo4j-modeling-skill",
        "neo4j-getting-started-skill"
      ],
      "vendorSays": "a <db-name>-schema.json anywhere in the project is read directly and live inspection is skipped; otherwise db.schema.* introspection",
      "releaseRule": "schema authority is the release-bound biotech-schema-context.v1 from the pinned workspace (biotech-schema-explore); db.schema.* and SHOW INDEXES diagnose deployment drift only and never change ontology authority",
      "authority": "AGENT-SKILLS section 1"
    },
    {
      "id": "OV-GENERIC-WRITES",
      "appliesTo": [
        "neo4j-cypher-skill",
        "neo4j-import-skill",
        "neo4j-getting-started-skill",
        "neo4j-spring-data-skill",
        "neo4j-document-import-skill",
        "neo4j-graphrag-skill",
        "neo4j-kafka-skill",
        "neo4j-spark-skill"
      ],
      "vendorSays": "MERGE/CREATE/SET/DELETE/DETACH DELETE/LOAD CSV examples",
      "releaseRule": "generic MERGE does not encode Biotech identity, evidence or episode semantics; DELETE examples are not ingestion procedures. Canonical writes go typed intent -> compiled plan -> apply (biotech-kg-ingest); data migration goes through biotech-graph-ops scripts; legacy data is never deleted",
      "authority": "AGENT-SKILLS section 1; KICKOFF non-negotiables"
    },
    {
      "id": "OV-ELEMENT-ID",
      "appliesTo": [
        "neo4j-cypher-skill",
        "neo4j-driver-javascript-skill",
        "neo4j-kafka-skill",
        "neo4j-migration-skill",
        "neo4j-modeling-skill",
        "neo4j-query-tuning-skill"
      ],
      "vendorSays": "elementId()/id() used to address nodes",
      "releaseRule": "elementId() is not durable identity (it changes across restore and store copies; observed in the S8 restore rehearsal). Domain identity is uid; legacy rows use their durable legacy key",
      "authority": "AGENT-SKILLS section 1; S8 restore evidence"
    },
    {
      "id": "OV-GDS-WRITEBACK",
      "appliesTo": [
        "neo4j-gds-skill",
        "neo4j-aura-graph-analytics-skill",
        "neo4j-snowflake-graph-analytics-skill",
        "neo4j-getting-started-skill"
      ],
      "vendorSays": "gds.<algo>.write / AGA write-back persists results to the database",
      "releaseRule": "write-back is not a fact writer (AGA writes in concurrent batches, one transaction per batch). Stream or mutate in-projection, seal an artifact, publish only through an admitted derived-projection intent. Not admitted in this release",
      "authority": "AGENT-SKILLS section 2 biotech-graph-analyze; OD-22"
    },
    {
      "id": "OV-READ-ROUTING",
      "appliesTo": [
        "neo4j-driver-javascript-skill",
        "neo4j-driver-python-skill",
        "neo4j-cypher-skill",
        "neo4j-mcp-skill"
      ],
      "vendorSays": "READ access mode / executeRead for read-only work",
      "releaseRule": "READ routing is not enforcement; read-only authority comes from the database principal (bks_reader) plus executor checks",
      "authority": "AGENT-SKILLS section 3"
    },
    {
      "id": "OV-CONFIRM-WRITES",
      "appliesTo": [
        "neo4j-cypher-skill",
        "neo4j-getting-started-skill",
        "neo4j-security-skill"
      ],
      "vendorSays": "confirm with the user before every write",
      "releaseRule": "does not add an approval gate to a previously authorized admitted workflow; admission and authority are enforced by the executor and principal",
      "authority": "AGENT-SKILLS section 1"
    },
    {
      "id": "OV-VECTOR-SEARCH",
      "appliesTo": [
        "neo4j-vector-index-skill",
        "neo4j-graphrag-skill",
        "neo4j-genai-plugin-skill"
      ],
      "vendorSays": "SEARCH clause / ai.text.* / db.index.vector.* for retrieval",
      "releaseRule": "native data vectors are disabled in this release (OD-44 profile recorded, not served); SEARCH needs >= 2026.01 and is unavailable on 5.26/5.27; schema semantic search uses OpenAI Vector Stores, never a Neo4j vector skill",
      "authority": "OD-44; TL-03; OPTIONAL-CAPABILITIES.md"
    },
    {
      "id": "OV-OPERATOR-ONLY",
      "appliesTo": [
        "neo4j-aura-provisioning-skill",
        "neo4j-security-skill",
        "neo4j-cli-tools-skill",
        "neo4j-import-skill"
