{
  "format": "bks-skill-example.v1",
  "id": "retired-mention",
  "kind": "negative",
  "task": "Stage an unresolved mention as a Mention node.",
  "lesson": "Mention is not a v2 type (OD-04). The old id answers with its migration record; the meaning is a SourceLocator plus a RESOLUTION Assessment (mention.stage). Never write a Mention.",
  "steps": [
    { "argv": ["get", "node:Mention", "--json"], "expect": { "exit": 0, "json": [{ "path": "kind", "equals": "alias" }, { "path": "record.targets", "includes": "node:SourceLocator" }] } },
    { "argv": ["find", "--kind", "node", "--name", "Mention", "--json"], "expect": { "exit": 1, "json": [{ "path": "total", "equals": 0 }] } },
    { "argv": ["get", "task:stage-unresolved-mention", "--section", "elements"], "expect": { "exit": 0, "stdoutIncludes": ["mention.stage"] } }
  ]
}
