{
  "mcpServers": {
    "pubmed": { "type": "http", "url": "https://pubmed.caseyjhand.com/mcp" },
    "pubchem": { "type": "http", "url": "https://pubchem.caseyjhand.com/mcp" },
    "clinicaltrialsgov": { "type": "http", "url": "https://clinicaltrials.caseyjhand.com/mcp" },
    "edgartools": {
      "command": "uvx",
      "args": ["--from", "edgartools[ai]", "edgartools-mcp"],
      "env": { "EDGAR_IDENTITY": "${EDGAR_IDENTITY}" }
    }
  }
}
